# Trestle Reverse Phone API (primary). Get a key at https://portal.trestleiq.com/signup
# Returns the registered owner's name + city/state.
TRESTLE_API_KEY=

# Optional: People Data Labs adds job title, company, and a real LinkedIn URL
# when it has a match. Get a key at https://dashboard.peopledatalabs.com
PDL_API_KEY=
# 1-10, higher = stricter PDL matches. 5 is a good default.
PDL_MIN_LIKELIHOOD=5
