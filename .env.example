# People Data Labs adds name, job title, company, and a real LinkedIn URL.
# Best single source for "who is this and where do they work".
# Get a key at https://dashboard.peopledatalabs.com
PDL_API_KEY=
# 1-10, higher = stricter PDL matches. 5 is a good default.
PDL_MIN_LIKELIHOOD=5

# Twilio Lookup (caller ID name, US). Pay-as-you-go, instant signup.
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Trestle Reverse Phone API (name + city/state). Optional extra coverage.
# Get a key at https://portal.trestleiq.com/signup
TRESTLE_API_KEY=
